# Локальные настройки репо знаний. Скопируйте в .env (он в .gitignore):
#   cp .env.example .env
# pre-commit хук и scripts/setup.sh читают .env автоматически.

# Каталог с исходниками, против которых drift-чекер сверяет brain.
# Пусто -> code_root из brain/claims.yaml (из коробки examples/demo-code).
# Несколько репо: укажите каталог с клонами, а в claims.yaml — source.repo.
# Пример: CODE_ROOT=~/code/acme
CODE_ROOT=

# 1 -> если код не найден (SKIPPED), коммит падает. Для CI и машин, где код
# обязан быть. Пусто или 0 -> SKIPPED не мешает коммиту.
DRIFT_STRICT=
